/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running benchmarking tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/phaseimpute -c benchmarking.config -profile <docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

plugins {
  id 'nf-co2footprint@1.0.0-beta'
}

process {
    resourceLimits = [
        cpus: 12,
        memory: '80.GB',
        time: '12.h'
    ]
    maxRetries = 2
    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_NORMALIZE_BCFTOOLS:VCFLIB_VCFFIXUP' {
        time   = { 10.h    * task.attempt }
    }
    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_CONCORDANCE_GLIMPSE2:GLIMPSE2_CONCORDANCE' {
        ext.args = "--gt-val --af-tag AF"
        ext.prefix = { "${meta.id}${meta.panel ? '_P' + meta.panel : ''}${meta.tools ? '_T' + meta.tools : ''}.concordance" }
        publishDir = [ enabled: false ]
    }
}
